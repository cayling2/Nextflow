        container = '/vast/hugen2076-2026f/workflows/hw2/container_images/plink_1.90b7.7.sif'
    }

    withName: MERGE_PLINK {
        container = '/vast/hugen2076-2026f/workflows/hw2/container_images/plink_1.90b7.7.sif'
    }

}

singularity.enabled = true
